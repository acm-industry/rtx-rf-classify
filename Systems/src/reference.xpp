#include <stdint.h>
#include "printf.h"
#include "rfio.h"

#define RFIO_MAGIC_IN  0x5246494fu  // "RFIO"
#define RFIO_MAGIC_OUT 0x434b4f21u  // "OK!"

int main(void) {
    printf("rfio_test waiting\n");

    uint32_t magic = rfio_read_u32();
    uint32_t value = rfio_read_u32();

    printf("rfio_test got magic=0x%x value=%u\n", magic, value);

    if (magic != RFIO_MAGIC_IN) {
        rfio_write_u32(0x45525221u); // "ERR!"
        return 1;
    }

    rfio_write_u32(RFIO_MAGIC_OUT);
    rfio_write_u32(value + 1);

    return 0;
}