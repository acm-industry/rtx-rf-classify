FROM ubuntu:24.04 AS base

ARG DEBIAN_FRONTEND=noninteractive

# ── System dependencies for LLVM, Verilator, and Bender ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build pkg-config \
    autoconf automake autotools-dev \
    device-tree-compiler libboost-regex-dev libboost-system-dev \
    libelf-dev flex libfl-dev bison help2man texinfo \
    zlib1g-dev \
    clang lld \
    python3 python3-pip \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

ENV ARA_DIR=/opt/ara

# ── Clone Ara (shallow) and selectively init required submodules ──
# Skip riscv-gnu-toolchain and riscv-isa-sim -- not needed for Verilator flow.
RUN git clone --depth 1 https://github.com/pulp-platform/ara.git ${ARA_DIR}

WORKDIR ${ARA_DIR}

RUN git submodule update --init --recursive toolchain/riscv-llvm && \
    git submodule update --init --recursive toolchain/newlib && \
    git submodule update --init --recursive toolchain/verilator

# ── Build RISC-V LLVM toolchain (Clang + newlib + compiler-rt) ──
# This is the longest step (~90 min). Each sub-target is a separate layer
# so partial failures can resume from cache.
RUN make toolchain-llvm-main -j"$(nproc)"
RUN make toolchain-llvm-newlib
RUN cd "${ARA_DIR}/toolchain/riscv-llvm/compiler-rt" && rm -rf build && mkdir -p build && cd build && \
    cmake "${ARA_DIR}/toolchain/riscv-llvm/compiler-rt" -G Ninja \
    -DCMAKE_INSTALL_PREFIX="${ARA_DIR}/install/riscv-llvm" \
    -DCMAKE_C_COMPILER_TARGET="riscv64-unknown-elf" \
    -DCMAKE_ASM_COMPILER_TARGET="riscv64-unknown-elf" \
    -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
    -DCOMPILER_RT_BAREMETAL_BUILD=ON \
    -DCOMPILER_RT_BUILD_BUILTINS=ON \
    -DCOMPILER_RT_BUILD_LIBFUZZER=OFF \
    -DCOMPILER_RT_BUILD_MEMPROF=OFF \
    -DCOMPILER_RT_BUILD_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_CTX_PROFILE=OFF \
    -DCOMPILER_RT_BUILD_SANITIZERS=OFF \
    -DCOMPILER_RT_BUILD_XRAY=OFF \
    -DCMAKE_C_COMPILER_WORKS=1 \
    -DCMAKE_CXX_COMPILER_WORKS=1 \
    -DCMAKE_SIZEOF_VOID_P=4 \
    -DCMAKE_C_COMPILER="${ARA_DIR}/install/riscv-llvm/bin/clang" \
    -DCMAKE_C_FLAGS="-march=rv64gc -mabi=lp64d -mno-relax -mcmodel=medany" \
    -DCMAKE_ASM_FLAGS="-march=rv64gc -mabi=lp64d -mno-relax -mcmodel=medany" \
    -DCMAKE_AR="${ARA_DIR}/install/riscv-llvm/bin/llvm-ar" \
    -DCMAKE_NM="${ARA_DIR}/install/riscv-llvm/bin/llvm-nm" \
    -DCMAKE_RANLIB="${ARA_DIR}/install/riscv-llvm/bin/llvm-ranlib" \
    -DLLVM_CONFIG_PATH="${ARA_DIR}/install/riscv-llvm/bin/llvm-config" && \
    cmake --build . --target install && \
    ln -s "${ARA_DIR}/install/riscv-llvm/lib/linux" "${ARA_DIR}/install/riscv-llvm/lib/clang/20/lib"

# ── Build Verilator ──
RUN make verilator

# ── Hardware: install Bender, checkout IPs, apply patches, verilate ──
RUN cd hardware && make checkout
RUN cd hardware && make apply-patches
# Strip non-printable/non-ASCII characters that Verilator 5.x rejects in .vlt files
RUN tr -cd '[:print:]\n\t' < hardware/tb/verilator/waiver.vlt > /tmp/waiver.vlt && \
    mv /tmp/waiver.vlt hardware/tb/verilator/waiver.vlt
RUN cd hardware && make verilate

ENV PATH="${ARA_DIR}/install/riscv-llvm/bin:${ARA_DIR}/install/verilator/bin:${PATH}"

WORKDIR /work
